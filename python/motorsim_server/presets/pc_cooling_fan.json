  "load": { "kind": "fan", "params": { "coefficient": 1e-07 } },
  "limits": { "current_limit": 1.0, "enabled": true },
  "thermal": {
    "ambient_c": 25.0,
    "overheat_c": 90.0,
    "thermal_resistance": 40.0,
    "thermal_capacitance": 4.0,
    "resistance_feedback": false
  },
  "drive": { "voltage": 12.0 }
}
